{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgc.dev/spec/orchestration-state/v1/schema.json",
  "title": "XGC Orchestration State Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "value"],
  "properties": {
    "schemaVersion": { "const": "xgc.orchestration-state/v1" },
    "kind": { "enum": ["run", "invocation-ledger", "effect", "runtime-binding", "command-ledger", "domain-event"] },
    "value": true
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "run" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/run" } } } },
    { "if": { "properties": { "kind": { "const": "invocation-ledger" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/invocationLedger" } } } },
    { "if": { "properties": { "kind": { "const": "effect" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/effect" } } } },
    { "if": { "properties": { "kind": { "const": "runtime-binding" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/runtimeBinding" } } } },
    { "if": { "properties": { "kind": { "const": "command-ledger" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/commandLedger" } } } },
    { "if": { "properties": { "kind": { "const": "domain-event" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/domainEvent" } } } }
  ],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "typeRef": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*/v[1-9][0-9]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "code", "message"],
      "properties": {
        "class": { "enum": ["transient", "permanent", "canceled", "uncertain"] },
        "code": { "$ref": "#/$defs/identifier" }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceRef": { "$ref": "#/$defs/identifier" }
      }
    },
    "actionRef": {
      "type": "object", "additionalProperties": false, "required": ["actionId", "version", "digest"],
      "properties": { "actionId": { "$ref": "#/$defs/identifier" }, "version": { "$ref": "#/$defs/identifier" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "termination": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "requestedBy", "reasonCode", "commandId", "requestedAt"],
      "properties": {
        "kind": { "enum": ["failed", "canceled", "stopped"] }, "requestedBy": { "$ref": "#/$defs/identifier" },
        "reasonCode": { "$ref": "#/$defs/identifier" }, "reason": { "type": "string", "maxLength": 4096 },
        "primaryFailure": { "$ref": "#/$defs/failure" }, "commandId": { "$ref": "#/$defs/identifier" }, "requestedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "parentRun": {
      "type": "object", "additionalProperties": false,
      "required": ["parentRunId", "parentInvocationId", "callNodeId", "mappingDigest"],
      "properties": {
        "parentRunId": { "$ref": "#/$defs/identifier" }, "parentInvocationId": { "$ref": "#/$defs/identifier" },
        "callNodeId": { "$ref": "#/$defs/identifier" }, "mappingDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "namespaceId", "actionRef", "executionPlanRef", "planDigest", "triggerRef", "triggerDigest", "inputDigest", "rootRunId", "actorRef", "sourceRef", "status", "acceptedAt", "updatedAt", "revision"],
      "properties": {
        "runId": { "$ref": "#/$defs/identifier" }, "namespaceId": { "$ref": "#/$defs/identifier" }, "actionRef": { "$ref": "#/$defs/actionRef" },
        "executionPlanRef": { "$ref": "#/$defs/identifier" }, "planDigest": { "$ref": "#/$defs/digest" },
        "triggerRef": { "$ref": "#/$defs/identifier" }, "triggerDigest": { "$ref": "#/$defs/digest" }, "inputDigest": { "$ref": "#/$defs/digest" },
        "provenanceArtifactRef": { "$ref": "#/$defs/identifier" }, "scopeRef": { "$ref": "#/$defs/identifier" }, "parent": { "$ref": "#/$defs/parentRun" },
        "rootRunId": { "$ref": "#/$defs/identifier" }, "actorRef": { "$ref": "#/$defs/identifier" }, "sourceRef": { "$ref": "#/$defs/identifier" },
        "correlationRef": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["accepted", "queued", "running", "waiting", "stopping", "succeeded", "failed", "canceled", "stopped", "rejected"] },
        "termination": { "$ref": "#/$defs/termination" }, "terminationKind": { "enum": ["completed", "failed", "canceled", "stopped", "rejected"] },
        "resultRef": { "$ref": "#/$defs/identifier" }, "primaryFailure": { "$ref": "#/$defs/failure" },
        "cleanupFailures": { "type": "array", "items": { "$ref": "#/$defs/failure" } },
        "acceptedAt": { "$ref": "#/$defs/timestamp" }, "startedAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["invocationId", "namespaceId", "runId", "nodeId", "typeRef", "descriptorDigest", "resolvedInputDigest", "inputRefsDigest", "status", "executionAttemptCount", "compensationStatus", "compensationAttemptCount", "createdAt", "updatedAt", "revision"],
      "properties": {
        "invocationId": { "$ref": "#/$defs/identifier" }, "namespaceId": { "$ref": "#/$defs/identifier" }, "runId": { "$ref": "#/$defs/identifier" }, "nodeId": { "$ref": "#/$defs/identifier" },
        "typeRef": { "$ref": "#/$defs/typeRef" }, "descriptorDigest": { "$ref": "#/$defs/digest" }, "resolvedInputDigest": { "$ref": "#/$defs/digest" }, "inputRefsDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["ready", "running", "waiting", "retry-wait", "succeeded", "failed", "canceled", "skipped"] },
        "activeAttemptId": { "$ref": "#/$defs/identifier" }, "activeCompensationAttemptId": { "$ref": "#/$defs/identifier" }, "executionAttemptCount": { "type": "integer", "minimum": 0 },
        "waitGeneration": { "type": "integer", "minimum": 1 }, "currentWaitRef": { "$ref": "#/$defs/identifier" }, "nextAttemptAt": { "$ref": "#/$defs/timestamp" },
        "outputRefsDigest": { "$ref": "#/$defs/digest" }, "primaryFailure": { "$ref": "#/$defs/failure" },
        "compensationStatus": { "enum": ["not-required", "unscheduled", "ready", "running", "retry-wait", "succeeded", "failed", "canceled"] },
        "compensationAttemptCount": { "type": "integer", "minimum": 0 }, "compensationFailure": { "$ref": "#/$defs/failure" }, "compensationNextAttemptAt": { "$ref": "#/$defs/timestamp" },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "startedAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" }, "finishedAt": { "$ref": "#/$defs/timestamp" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attemptId", "namespaceId", "runId", "invocationId", "phase", "ordinal", "status", "resolvedInputDigest", "ownerRef", "leaseTokenHash", "leaseExpiresAt", "adoptionCount", "createdAt", "startedAt", "updatedAt", "revision"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/identifier" }, "namespaceId": { "$ref": "#/$defs/identifier" }, "runId": { "$ref": "#/$defs/identifier" }, "invocationId": { "$ref": "#/$defs/identifier" },
        "phase": { "enum": ["execution", "compensation"] }, "ordinal": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["running", "waiting", "succeeded", "failed", "canceled", "abandoned"] }, "resolvedInputDigest": { "$ref": "#/$defs/digest" },
        "ownerRef": { "$ref": "#/$defs/identifier" }, "leaseTokenHash": { "$ref": "#/$defs/digest" }, "leaseExpiresAt": { "$ref": "#/$defs/timestamp" },
        "adoptionCount": { "type": "integer", "minimum": 0 }, "checkpointRef": { "$ref": "#/$defs/identifier" }, "checkpointDigest": { "$ref": "#/$defs/digest" },
        "failure": { "$ref": "#/$defs/failure" }, "createdAt": { "$ref": "#/$defs/timestamp" }, "startedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }, "finishedAt": { "$ref": "#/$defs/timestamp" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "invocationLedger": {
      "type": "object", "additionalProperties": false, "required": ["invocation", "attempts"],
      "properties": { "invocation": { "$ref": "#/$defs/invocation" }, "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } } }
    },
    "effectIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "namespaceId", "runId", "invocationId", "preparedAttemptId", "effectKey", "kind", "targetRef", "intentSchemaDigest", "intentDigest", "ownership", "compensationPolicy", "policyDigest", "descriptorDigest", "deadline"],
      "properties": {
        "effectId": { "$ref": "#/$defs/identifier" }, "namespaceId": { "$ref": "#/$defs/identifier" }, "runId": { "$ref": "#/$defs/identifier" }, "invocationId": { "$ref": "#/$defs/identifier" },
        "preparedAttemptId": { "$ref": "#/$defs/identifier" }, "effectKey": { "$ref": "#/$defs/identifier" }, "kind": { "$ref": "#/$defs/typeRef" }, "targetRef": { "$ref": "#/$defs/identifier" },
        "intentSchemaDigest": { "$ref": "#/$defs/digest" }, "intentDigest": { "$ref": "#/$defs/digest" }, "intentArtifactRef": { "$ref": "#/$defs/identifier" },
        "ownership": { "enum": ["owned", "attached", "shared"] }, "compensationPolicy": { "enum": ["none", "required", "best-effort"] },
        "requiredCapabilityRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "policyDigest": { "$ref": "#/$defs/digest" }, "descriptorDigest": { "$ref": "#/$defs/digest" }, "deadline": { "$ref": "#/$defs/timestamp" }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "intent", "preparationDigest", "state", "compensationState", "compensationAttemptCount", "preparedAt", "updatedAt", "revision"],
      "properties": {
        "effectId": { "$ref": "#/$defs/identifier" }, "intent": { "$ref": "#/$defs/effectIntent" }, "preparationDigest": { "$ref": "#/$defs/digest" },
        "state": { "enum": ["prepared", "applying", "applied", "failed", "uncertain"] }, "commandId": { "$ref": "#/$defs/identifier" }, "commandIdentityDigest": { "$ref": "#/$defs/digest" },
        "externalIdentity": { "$ref": "#/$defs/identifier" }, "resultDigest": { "$ref": "#/$defs/digest" }, "resultArtifactRef": { "$ref": "#/$defs/identifier" }, "primaryFailure": { "$ref": "#/$defs/failure" },
        "compensationState": { "enum": ["not-required", "unscheduled", "pending", "running", "retry-wait", "succeeded", "failed", "canceled"] },
        "compensationAttemptCount": { "type": "integer", "minimum": 0 }, "compensationCommandId": { "$ref": "#/$defs/identifier" }, "compensationFailure": { "$ref": "#/$defs/failure" }, "compensationNextAttemptAt": { "$ref": "#/$defs/timestamp" },
        "preparedAt": { "$ref": "#/$defs/timestamp" }, "applyingAt": { "$ref": "#/$defs/timestamp" }, "primaryTerminalAt": { "$ref": "#/$defs/timestamp" },
        "compensationStartedAt": { "$ref": "#/$defs/timestamp" }, "compensationFinishedAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "runtimeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "namespaceId", "runId", "invocationId", "nodeId", "runtimeKey", "kind", "specDigest", "providerRef", "providerDigest", "ownership", "cleanupPolicy", "state", "observedState", "health", "generation", "fencingToken", "leaseOwner", "leaseTokenHash", "leaseExpiresAt", "createdAt", "updatedAt", "revision"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/identifier" }, "namespaceId": { "$ref": "#/$defs/identifier" }, "runId": { "$ref": "#/$defs/identifier" },
        "invocationId": { "$ref": "#/$defs/identifier" }, "nodeId": { "$ref": "#/$defs/identifier" }, "runtimeKey": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/typeRef" }, "specDigest": { "$ref": "#/$defs/digest" }, "providerRef": { "$ref": "#/$defs/identifier" }, "providerDigest": { "$ref": "#/$defs/digest" },
        "ownership": { "enum": ["owned", "attached", "shared"] }, "cleanupPolicy": { "enum": ["none", "on-run-close", "on-scope-exit"] },
        "state": { "enum": ["preparing", "active", "stopping", "released", "lost"] },
        "observedState": { "enum": ["unknown", "starting", "running", "stopping", "stopped", "failed", "lost"] },
        "health": { "enum": ["unknown", "healthy", "degraded", "unhealthy", "lost"] }, "externalIdentity": { "$ref": "#/$defs/identifier" },
        "generation": { "type": "integer", "minimum": 1 }, "fencingToken": { "type": "integer", "minimum": 1 },
        "leaseOwner": { "type": "string" }, "leaseTokenHash": { "type": "string" }, "leaseExpiresAt": { "$ref": "#/$defs/timestamp" },
        "observationDigest": { "$ref": "#/$defs/digest" }, "observationAt": { "$ref": "#/$defs/timestamp" }, "primaryFailure": { "$ref": "#/$defs/failure" },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "activatedAt": { "$ref": "#/$defs/timestamp" }, "releaseStartedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "revisionFence": { "type": "object", "additionalProperties": false, "required": ["targetId", "expectedRevision"], "properties": { "targetId": { "$ref": "#/$defs/identifier" }, "expectedRevision": { "type": "integer", "minimum": 1 } } },
    "generationFence": { "type": "object", "additionalProperties": false, "required": ["bindingId", "generation", "fencingToken"], "properties": { "bindingId": { "$ref": "#/$defs/identifier" }, "generation": { "type": "integer", "minimum": 1 }, "fencingToken": { "type": "integer", "minimum": 1 } } },
    "createFence": { "type": "object", "additionalProperties": false, "required": ["targetNamespace", "identityDigest"], "properties": { "targetNamespace": { "$ref": "#/$defs/identifier" }, "identityDigest": { "$ref": "#/$defs/digest" } } },
    "fence": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "revision"], "properties": { "kind": { "const": "revision" }, "revision": { "$ref": "#/$defs/revisionFence" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "generation"], "properties": { "kind": { "const": "generation" }, "generation": { "$ref": "#/$defs/generationFence" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "idempotentCreate"], "properties": { "kind": { "const": "idempotent-create" }, "idempotentCreate": { "$ref": "#/$defs/createFence" } } }
      ]
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["commandId", "effectId", "idempotencyKeyHash", "identityDigest", "namespaceId", "targetRef", "action", "actorRef", "sourceRef", "reasonCode", "risk", "fence", "payloadDigest", "policyDigest", "descriptorDigest", "deadline", "cancellationId"],
      "properties": {
        "commandId": { "$ref": "#/$defs/identifier" }, "requestId": { "$ref": "#/$defs/identifier" }, "effectId": { "$ref": "#/$defs/identifier" },
        "idempotencyKeyHash": { "$ref": "#/$defs/digest" }, "identityDigest": { "$ref": "#/$defs/digest" }, "namespaceId": { "$ref": "#/$defs/identifier" },
        "targetRef": { "$ref": "#/$defs/identifier" }, "action": { "$ref": "#/$defs/identifier" }, "actorRef": { "$ref": "#/$defs/identifier" }, "sourceRef": { "$ref": "#/$defs/identifier" },
        "reasonCode": { "$ref": "#/$defs/identifier" }, "reason": { "type": "string", "maxLength": 4096 }, "risk": { "enum": ["low", "moderate", "high"] }, "fence": { "$ref": "#/$defs/fence" },
        "payloadDigest": { "$ref": "#/$defs/digest" }, "payloadArtifactRef": { "$ref": "#/$defs/identifier" }, "policyDigest": { "$ref": "#/$defs/digest" },
        "descriptorDigest": { "$ref": "#/$defs/digest" }, "manifestDigest": { "$ref": "#/$defs/digest" }, "deadline": { "$ref": "#/$defs/timestamp" }, "cancellationId": { "$ref": "#/$defs/identifier" },
        "requiredCapabilityRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }, "capabilityTokenHash": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptId", "commandId", "sequence", "status", "identityDigest", "fenceDigest", "providerRef", "providerDigest", "policyDigest", "authorizationDigest", "observedAt"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/identifier" }, "commandId": { "$ref": "#/$defs/identifier" }, "sequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["accepted", "rejected", "succeeded", "failed", "uncertain"] }, "identityDigest": { "$ref": "#/$defs/digest" }, "fenceDigest": { "$ref": "#/$defs/digest" },
        "providerRef": { "$ref": "#/$defs/identifier" }, "providerDigest": { "$ref": "#/$defs/digest" }, "policyDigest": { "$ref": "#/$defs/digest" }, "authorizationDigest": { "$ref": "#/$defs/digest" },
        "resultDigest": { "$ref": "#/$defs/digest" }, "resultArtifactRef": { "$ref": "#/$defs/identifier" }, "externalIdentity": { "$ref": "#/$defs/identifier" }, "failure": { "$ref": "#/$defs/failure" }, "observedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "commandLedger": {
      "type": "object", "additionalProperties": false, "required": ["envelope", "receipts"],
      "properties": { "envelope": { "$ref": "#/$defs/command" }, "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } } }
    },
    "domainEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "aggregateType", "aggregateId", "aggregateRevision", "type", "commandId", "payloadSchemaDigest", "payloadDigest", "payload", "occurredAt"],
      "properties": {
        "eventId": { "$ref": "#/$defs/identifier" }, "aggregateType": { "$ref": "#/$defs/identifier" }, "aggregateId": { "$ref": "#/$defs/identifier" },
        "aggregateRevision": { "type": "integer", "minimum": 1 }, "type": { "$ref": "#/$defs/identifier" }, "commandId": { "$ref": "#/$defs/identifier" },
        "causationId": { "$ref": "#/$defs/identifier" }, "correlationId": { "$ref": "#/$defs/identifier" }, "payloadSchemaDigest": { "$ref": "#/$defs/digest" },
        "payloadDigest": { "$ref": "#/$defs/digest" }, "payload": { "type": "object" }, "occurredAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
