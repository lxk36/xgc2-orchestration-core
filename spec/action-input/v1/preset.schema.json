{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgc.dev/spec/action-input/v1/preset.schema.json",
  "title": "XGC ActionPresetVersion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["presetId", "version", "digest", "actionRef", "values"],
  "properties": {
    "presetId": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/identifier" },
    "digest": { "$ref": "#/$defs/digest" },
    "actionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "version", "digest"],
      "properties": {
        "actionId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "values": { "type": "object" },
    "overridablePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
    },
    "policyRef": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
