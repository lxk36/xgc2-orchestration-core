{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgc.dev/spec/value-expression/v1/schema.json",
  "title": "XGC ValueExpr v1",
  "$ref": "#/$defs/expression",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": true }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "and", "or", "not", "eq", "ne", "lt", "lte", "gt", "gte",
                "add", "sub", "mul", "div", "coalesce", "concat", "length", "contains"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["object"],
          "properties": {
            "object": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["array"],
          "properties": {
            "array": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        }
      ]
    }
  }
}
